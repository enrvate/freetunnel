+// Added by FreeTunnel: what a connect request tells us, digested into plain
+// values. The core's VpnConnectRequestEvent points at memory that does not
+// outlive its callback, and the decision below is taken on another thread, so
+// the wrapper copies out what a client could need rather than handing over
+// pointers that would already be dangling by the time it looks at them.
+struct VpnConnectRequestSnapshot {
+    uint64_t id = 0;        // connection id, matches VpnConnectionInfo::id
+    int proto = 0;          // IPPROTO_TCP / IPPROTO_UDP
+    int family = 0;         // AF_INET / AF_INET6, 0 if the source was absent
+    uint16_t src_port = 0;  // host byte order
+    std::string src_ip;     // presentation form, empty if the source was absent
+    std::string app_name;   // what the core already knew; empty on the TUN path
+};
+
+// Added by FreeTunnel: what the client decides about one connection.
+struct VpnConnectDecision {
+    VpnConnectAction action = VPN_CA_DEFAULT;
+    // Optional. Named here so it appears in the core's own connection log and
+    // so vpn_reset_connections() can address this app later. The wrapper keeps
+    // the string alive until the core has copied it.
+    std::string app_name;
+    int uid = -1;
+};
