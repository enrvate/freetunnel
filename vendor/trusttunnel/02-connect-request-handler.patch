 namespace ag {
 
+// Added by FreeTunnel: digest a connect request's source address into plain
+// values the decision handler can use after this callback has returned.
+static void ft_fill_connect_snapshot(const VpnConnectRequestEvent *event, VpnConnectRequestSnapshot *out) {
+    out->id = event->id;
+    out->proto = event->proto;
+    out->app_name = safe_to_string_view(event->app_name);
+    if (event->src == nullptr) {
+        return;
+    }
+    out->family = event->src->sa_family;
+    char buf[INET6_ADDRSTRLEN] = {};
+    if (event->src->sa_family == AF_INET) {
+        const auto *in4 = (const struct sockaddr_in *) event->src;
+        out->src_port = ntohs(in4->sin_port);
+        if (inet_ntop(AF_INET, (const void *) &in4->sin_addr, buf, sizeof(buf)) != nullptr) {
+            out->src_ip = buf;
+        }
+    } else if (event->src->sa_family == AF_INET6) {
+        const auto *in6 = (const struct sockaddr_in6 *) event->src;
+        out->src_port = ntohs(in6->sin6_port);
+        if (inet_ntop(AF_INET6, (const void *) &in6->sin6_addr, buf, sizeof(buf)) != nullptr) {
+            out->src_ip = buf;
+        }
+    }
+}
